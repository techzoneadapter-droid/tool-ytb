# Google Flow Python: import EditThisCookie JSON in the app; headless only.
# Install workers/flow-requirements.txt into .flow-venv. No cookies in this file.
FLOW_PYTHON=
# Installed Chrome in headless mode; no personal profile or CDP access.
FLOW_BROWSER_CHANNEL=chrome
FLOW_COOKIES_FILE=cookies.json
FLOW_PROJECT_URL=
FLOW_BRIDGE_URL=http://127.0.0.1:7865
FLOW_MODEL_LABEL=Nano Banana Pro
FLOW_GENERATION_TIMEOUT_MS=420000
# FastAPI process/health startup only; Chrome/project restoration runs separately.
FLOW_START_TIMEOUT_MS=15000
FLOW_RESTORE_TIMEOUT_MS=180000
# Verify that submit starts generation; separate from the image result timeout.
FLOW_GENERATION_START_TIMEOUT_MS=15000
# Flow project model/aspect/count are preserved. Image buffers never touch disk.
FLOW_CONCURRENCY=1
FLOW_RENDER_CONCURRENCY=2
# Screenshot/HTML/error metadata only; never generation image files.
FLOW_DEBUG=0

# Independent video pipelines. 2 is a safe default for a low-end Windows PC.
# Increase to 3 only if CPU/RAM/network remain stable. Hard limit in app: 4.
MAX_PARALLEL_VIDEOS=2

# Edge TTS Online: no API key. StoryFlow invokes a pinned node-edge-tts CLI through npx.
# Requires internet; Microsoft may throttle unofficial Read Aloud traffic.

# Community/free cloud fallbacks
# AI Horde works anonymously with the default key 0000000000 (lower priority).
# Set your own free AI Horde key for better queue priority.
AI_HORDE_API_KEY=
AI_HORDE_MODEL=

# Pollinations Image can fall back to anonymous generation.
# TTS / higher quotas require a key from enter.pollinations.ai.
# Keep this server-side only; never commit .env.local.
POLLINATIONS_API_KEY=
POLLINATIONS_TTS_MODEL=
POLLINATIONS_IMAGE_MODEL=flux

# Preferred cloud GPU path. Deploy cloud/modal/*.py first.
# Leave empty to keep StoryFlow on local engines.
MODAL_TTS_URL=
MODAL_IMAGE_URL=
# Optional shared bearer token. Set the same STORYFLOW_MODAL_TOKEN secret on Modal.
MODAL_AUTH_TOKEN=
# Configurable SDXL base for StoryDiffusion. Review the model license before commercial use.
STORYFLOW_SDXL_MODEL=stabilityai/stable-diffusion-xl-base-1.0

DEFAULT_TTS_PROVIDER=vieneu-local
DEFAULT_VIETNAMESE_VOICE=Ngọc Huyền
FLUX2_WORKER_URL=http://127.0.0.1:7861
FLUX2_MODEL=flux2-klein-4b
WAN22_WORKER_URL=http://127.0.0.1:7862
WAN22_MODEL=ti2v-5b
# Only required for the optional Python Wan worker:
WAN22_REPO_DIR=
WAN22_CHECKPOINT_DIR=
VIENEU_LOCAL_URL=http://127.0.0.1:8000
KORVATTS_BIN=korvatts
# TTS_PROVIDER below applies only when selecting a cloud voice explicitly.
OPENAI_API_KEY=
TTS_PROVIDER=openai
TTS_API_KEY=
TTS_MODEL=tts-1
# Optional Azure Speech alternative: TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Only map a preset to its actual licensed provider voice ID. Never substitute another person's voice.
# For Azure's built-in Hoai My: {"hoai-my":"vi-VN-HoaiMyNeural"}
# Ngoc Huyen must have its own genuine provider voice ID; no automatic alias exists.
TTS_VOICE_MAP={}
IMAGE_PROVIDER=openai
IMAGE_API_KEY=
TEXT_MODEL=gpt-4o-mini
IMAGE_MODEL=gpt-image-1
# Image API choices in the UI: openai, gemini, stability.
# IMAGE_API_KEY / IMAGE_MODEL remain OpenAI-only legacy overrides.
# OPENAI_IMAGE_MODEL overrides IMAGE_MODEL when set.
OPENAI_IMAGE_MODEL=
# Google AI Studio key; GOOGLE_API_KEY is also accepted.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
STABILITY_API_KEY=
# Stable Image endpoint: core or ultra.
STABILITY_IMAGE_MODEL=core
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional local service paths (executables only, never a shell command):
VIENEU_REPO_DIR=
KORVA_PYTHON=
KORVA_LOCAL_URL=http://127.0.0.1:7863
LOCAL_AI_PYTHON=
# Defaults: .tts-venv/Scripts/python.exe and .ai-venv/Scripts/python.exe on Windows.
# Korva requests and scene resources run serially (safe concurrency=1).
