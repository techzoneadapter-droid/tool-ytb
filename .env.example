DEFAULT_TTS_PROVIDER=vieneu-local
DEFAULT_VIETNAMESE_VOICE=Ngọc Huyền
FLUX2_WORKER_URL=http://127.0.0.1:7861
FLUX2_MODEL=flux2-klein-4b
WAN22_WORKER_URL=http://127.0.0.1:7862
WAN22_MODEL=ti2v-5b
# Only required for the optional Python Wan worker:
WAN22_REPO_DIR=
WAN22_CHECKPOINT_DIR=
VIENEU_LOCAL_URL=http://127.0.0.1:8000
KORVATTS_BIN=korvatts
# TTS_PROVIDER below applies only when selecting a cloud voice explicitly.
OPENAI_API_KEY=
TTS_PROVIDER=openai
TTS_API_KEY=
TTS_MODEL=tts-1
# Optional Azure Speech alternative: TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Only map a preset to its actual licensed provider voice ID. Never substitute another person's voice.
# For Azure's built-in Hoai My: {"hoai-my":"vi-VN-HoaiMyNeural"}
# Ngoc Huyen must have its own genuine provider voice ID; no automatic alias exists.
TTS_VOICE_MAP={}
IMAGE_PROVIDER=openai
IMAGE_API_KEY=
TEXT_MODEL=gpt-4o-mini
IMAGE_MODEL=gpt-image-1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
