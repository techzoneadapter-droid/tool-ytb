{
  "name": "storyflow-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "desktop": "node desktop/launch.cjs",
    "desktop:build": "npm run build",
    "dev": "tsx scripts/app.ts",
    "build": "next build",
    "start": "tsx scripts/app.ts --production",
    "worker": "tsx scripts/worker.ts",
    "test": "tsx --test tests/core.test.ts tests/flow-pipeline.test.ts tests/flow-chapter.test.ts tests/image-api.test.ts tests/image-api-connect.test.ts tests/chapter-images.test.ts tests/chapter-worker.test.ts tests/bulk-delete.test.ts tests/pipeline-progress.test.tsx tests/shared-image.test.ts tests/adaptive-pipeline.test.tsx",
    "test:flow": "tsx --test tests/flow.test.ts tests/flow-session.test.ts tests/flow-bridge.test.ts",
    "test:flow:python": "node scripts/test-flow-python.cjs",
    "smoke:flow:scene": "tsx scripts/smoke-flow-scene.ts",
    "smoke:flow:cold-start": "tsx scripts/smoke-flow-cold-start.ts",
    "app": "tsx scripts/app.ts",
    "check:conflicts": "node scripts/check-conflicts.mjs",
    "preapp": "npm run check:conflicts",
    "prebuild": "npm run check:conflicts",
    "pretest": "npm run check:conflicts",
    "smoke:flow:chapter": "tsx scripts/smoke-flow-chapter.ts"
  },
  "dependencies": {
    "dotenv": "^17.0.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "next": "16.2.1",
    "playwright": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^44.5.1",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
